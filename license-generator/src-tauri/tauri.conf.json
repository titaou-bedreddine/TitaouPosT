{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TitaouPOS License Generator",
  "version": "0.6.0",
  "identifier": "com.titaou.licensegen",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "TitaouPOS License Generator — Developer Tool",
        "width": 980,
        "height": 860,
        "minWidth": 820,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false
  }
}
